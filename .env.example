# Copy to .env and fill in real values. Never commit .env.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_hex(32))"

# Signs session cookies. Changing it logs everyone out.
WW_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Postgres in docker-compose; sqlite file path for local dev.
WW_DATABASE_URL=sqlite:///./waiverwire.db

# Password for the Postgres user in docker-compose.
WW_DB_PASSWORD=change-me

# Port the app listens on.
WW_PORT=8000

# Snapshot built by dashboard/build_data.py.
WW_DATA_PATH=./dashboard/data.json

# Guards POST /api/admin/refresh (reloads the data snapshot).
WW_ADMIN_TOKEN=change-me-to-a-random-token

# Set to true behind HTTPS so the session cookie is Secure.
WW_COOKIE_SECURE=false
